{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo run:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo check:*)",
      "Bash(cargo +nightly fuzz build:*)",
      "Bash(rustup target add:*)",
      "Bash(wasm-pack build:*)",
      "Bash(python3 -m http.server:*)",
      "Bash(bash .claude/hooks/test-guard-chesscom-url.sh:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|Bash|mcp__.*(chrome|browser|playwright|puppeteer).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-chesscom-url.py\""
          }
        ]
      }
    ]
  }
}
